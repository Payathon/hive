# hive production settings. Copy to /opt/hive/.env and fill in.
# Empty values count as unset. docker compose reads this file both for ${...} in docker-compose.yml
# and as the hive container's environment.

# ---- 必填 -------------------------------------------------------------------
# Your domain; its A record must point at this server. Caddy gets the HTTPS certificate for it.
# Without a domain yet, <name>.<ip with dashes>.sslip.io resolves to the IP (hive.47-84-123-150.sslip.io).
DOMAIN=hive.example.com
# Postgres password (only used inside the compose network; make it long and random: openssl rand -hex 24).
POSTGRES_PASSWORD=change-me

# Which compose files make up the stack (docker compose reads this from .env too).
# Shared server with the edge Caddy (deploy/edge, /opt/edge) in front of several apps:
COMPOSE_FILE=docker-compose.yml:docker-compose.edge.yml
# hive alone on the machine, with its own Caddy on 80/443:
# COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml
# Add :docker-compose.build.yml to either to build the image here from a checkout instead of pulling.

# ---- 地址（默认都是 https://$DOMAIN，一般不用改） -------------------------------
# Where agents and links reach the server: /agent.md, the CLI download, payment callbacks.
# PUBLIC_URL=https://hive.example.com
# Where approval and order links open the web app; same origin, the server serves the web app itself.
# WEB_URL=https://hive.example.com
# Defaults to the compose Postgres: postgres://hive:$POSTGRES_PASSWORD@postgres:5432/hive
# DATABASE_URL=
# Image to run; deploy.yml pins nothing, so latest is whatever main last built.
# HIVE_IMAGE=ghcr.io/payathon/hive:latest

# ---- 支付 ------------------------------------------------------------------
# fake | direct | platform. Unset: direct when ALIPAY_* and NOWPAY_DIRECT_PRODUCT_ID are all set, else fake.
# fake: no real money; purchase links open /v1/dev/fake-pay/... and ANYONE with the link can "pay".
# With fake payments (and no SMTP) the /v1/dev/* pages are public: fake-pay and the mail outbox
# (/v1/dev/mail shows every mail hive would have sent, with their order links). Fine for the
# hackathon demo, not for real users.
# PAYMENTS=fake
# Alipay open platform app (即刻收直连). Keys inline (one line, bare base64 is fine) or as files
# mounted under ./secrets (ALIPAY_PRIVATE_KEY_PATH=/secrets/app_private.txt).
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PRIVATE_KEY_PATH=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_PUBLIC_KEY_PATH=
# ALIPAY_GATEWAY=
# 即刻收 product id (np_d_...), its 1-count SKU (optional), and per-category products (optional JSON).
# NOWPAY_DIRECT_PRODUCT_ID=
# NOWPAY_DIRECT_SKU_ID=
# NOWPAY_DIRECT_PRODUCTS={"onsite.photo":"np_d_xxx"}

# ---- 邮件（不配就进测试收件箱 /v1/dev/mail，不真发） ------------------------------
# Either one URL (smtps://user:pass@smtp.example.com:465) or host/port/user/pass.
# SMTP_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=hive <noreply@hive.example.com>

# ---- Web Push（可选） --------------------------------------------------------
# Without these, keys are generated once and kept in the data volume (/data/vapid.json).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ---- 其他（一般不用动） -------------------------------------------------------
# Background sweep interval (payments, timeouts) in ms.
# TICK_MS=5000
# Host ports Caddy listens on (docker-compose.caddy.yml only; the edge always takes 80/443).
# HTTP_PORT=80
# HTTPS_PORT=443
# Already set in the image: PORT=8787 WEB_DIST=/app/web HIVE_CLI_BUNDLE=/app/cli/hive.mjs
# FILES_DIR=/data/files VAPID_FILE=/data/vapid.json FAKE_PAY_STATE=/data/fake-pay.json
